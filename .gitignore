# Carpetas y archivos del sistema
.DS_Store
Thumbs.db
*.log
*.zip

# Respaldos y PDFs de pliegos
backups/
RFP_MEROE-DIGITAL-2026-001.pdf

# Dependencias locales y compilaciones
