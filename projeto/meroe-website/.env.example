# ============================================================
# MEROE Website (Vercel) — Variáveis de Ambiente
# NUNCA colocar valores reais no GitHub
# Configurar em: Vercel Dashboard → Settings → Environment Variables
# ============================================================

# Gemini API Key (obtida em aistudio.google.com)
# ATENÇÃO: Esta chave é usada apenas em /api/chat.js (Vercel Function serverless)
# NUNCA expor no frontend directamente
GEMINI_API_KEY=COLOCAR_AQUI_A_SUA_CHAVE_GEMINI

# URL do projecto (actualizar quando tiver domínio próprio)
APP_URL=https://meroe-digital.vercel.app
