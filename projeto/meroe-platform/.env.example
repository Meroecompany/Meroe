# ============================================================
# MEROE Platform v2 — Variáveis de Ambiente
# COPIAR PARA .env e preencher TODOS os valores
# NUNCA enviar .env para o GitHub (está no .gitignore)
# ============================================================

NODE_ENV=production
PORT=4000
APP_URL=https://meroe-digital.vercel.app
ALLOWED_ORIGINS=https://meroe-digital.vercel.app,https://meroe-engineering.com,https://www.meroe-engineering.com
LOG_LEVEL=info

# ── BASE DE DADOS (Supabase) ───────────────────────────────────
# Supabase Dashboard → Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Pool de conexões (opcionais — defaults seguros)
DB_POOL_MAX=25
DB_POOL_MIN=5
DB_IDLE_TIMEOUT=30000

# ── JWT ────────────────────────────────────────────────────────
# Gerar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GERAR_64_BYTES_HEX_AQUI_MINIMO_64_CARACTERES
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=GERAR_OUTRO_64_BYTES_HEX_COMPLETAMENTE_DIFERENTE
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=GERAR_MAIS_UM_32_BYTES_HEX_PARA_COOKIES_ASSINADOS

# ── FIREBASE ADMIN ─────────────────────────────────────────────
# Firebase Console → Definições do projecto → Contas de serviço → Gerar nova chave
FIREBASE_PROJECT_ID=meroe-digital-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-XXXX@meroe-digital-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCOLAR_AQUI\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=meroe-digital-prod.appspot.com

# ── IA (Gemini) ────────────────────────────────────────────────
# ATENÇÃO: Nunca expor esta chave no frontend!
# Renovar periodicamente em aistudio.google.com
GEMINI_API_KEY=COLOCAR_AQUI

# ── EMAIL (SMTP) ───────────────────────────────────────────────
# Opção A: Zoho Mail
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=noreply@meroe-engineering.com
SMTP_PASS=PASSWORD_ZOHO_AQUI

# Opção B: Resend (recomendado — melhor deliverability, 3000/mês grátis)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_XXXXXXXXXXXXXXXX

# ── MONITORING (opcional mas recomendado em produção) ──────────
# Sentry DSN para tracking de erros
# SENTRY_DSN=https://XXXX@oXXXX.ingest.sentry.io/XXXX
