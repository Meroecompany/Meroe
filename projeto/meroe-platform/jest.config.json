{
  "testEnvironment": "node",
  "testMatch": ["**/tests/**/*.test.js"],
  "setupFiles": ["./tests/setup.js"],
  "collectCoverageFrom": ["src/**/*.js", "!src/scripts/**"],
  "coverageThreshold": {
    "global": { "statements": 20, "branches": 5, "functions": 10, "lines": 20 }
  },
  "testTimeout": 15000,
  "verbose": true
}
