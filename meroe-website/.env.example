# ============================================================
# MEROE — Variáveis de Ambiente para o Vercel
# ============================================================
# COMO CONFIGURAR:
# 1. Vai ao Vercel Dashboard
# 2. Clica no projecto → Settings → Environment Variables
# 3. Adiciona cada variável abaixo
# NUNCA coloques este ficheiro no GitHub com valores reais
# ============================================================

# Gemini API Key (obtida em aistudio.google.com)
GEMINI_API_KEY=tu_clave_de_api_aqui


# URL do projecto (actualiza quando tiveres domínio próprio)
NEXT_PUBLIC_APP_URL=https://meroe-digital.vercel.app

# Firebase (para a plataforma de talentos — Fase 3)
# FIREBASE_PROJECT_ID=meroe-digital-prod
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Supabase (para a plataforma de talentos — Fase 3)  
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_KEY=
